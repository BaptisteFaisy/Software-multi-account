name: codex-switch-terminal

services:
  cst:
    image: {{ cst_effective_image | to_json }}
    container_name: codex-switch-terminal
    restart: unless-stopped
    init: true
    env_file:
      - /etc/codex-switch-terminal/cst.env
    ports:
      - "127.0.0.1:{{ cst_remote_port }}:8080"
    volumes:
      - type: bind
        source: /srv/cst
        target: /srv/cst
        bind:
          propagation: rslave
    # Sans plafond, une derive du runtime consomme toute la RAM de l'hote PUIS
    # tout son swap. Le noyau ne declenche alors aucun OOM-kill (le swap absorbe
    # la demande) et la VM entiere part en thrashing : plus rien n'est ordonnance,
    # ni sshd ni tailscaled, et la machine devient totalement injoignable jusqu'a
    # un reset force. C'est exactement la panne du 2026-07-27 (RAM 94 %, swap
    # 100 %, %idle 0,02 %, 3 h d'indisponibilite).
    # Avec ce plafond, le depassement tue le processus fautif DANS le conteneur
    # et l'hote reste administrable.
    mem_limit: {{ cst_memory_limit_mb | int }}m
    # Egal a mem_limit => le conteneur n'a acces a AUCUN swap. Le swap de l'hote
    # reste disponible pour l'hote. C'est deliberé : c'est le swap qui a change
    # un incident de quelques minutes en indisponibilite de trois heures.
    memswap_limit: {{ cst_memory_limit_mb | int }}m
{% if cst_gpu_transcription | default(false) | bool %}
    depends_on:
      speaches:
        condition: service_healthy
{% endif %}
    stop_grace_period: 45s
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8080/healthz"]
      interval: 15s
      timeout: 4s
      start_period: 20s
      retries: 8
{% if cst_gpu_transcription | default(false) | bool %}

  speaches:
    image: {{ cst_speaches_image | to_json }}
    container_name: codex-switch-terminal-speaches
    restart: unless-stopped
    init: true
    expose:
      - "8000"
    volumes:
      - speaches-models:/home/ubuntu/.cache/huggingface/hub
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    healthcheck:
      test: ["CMD", "curl", "--fail", "http://127.0.0.1:8000/health"]
      interval: 15s
      timeout: 5s
      start_period: 20s
      retries: 12
    security_opt:
      - no-new-privileges:true

volumes:
  speaches-models:
{% endif %}
