CST_BIND=127.0.0.1:8080
CST_DATA_DIR=/srv/cst
# Optionnel : partage uniquement settings.json entre plusieurs instances tout
# en gardant agents, locks et salons isoles dans CST_DATA_DIR.
# CST_ACCOUNTS_DIR=/srv/cst-shared-accounts
CST_STATIC_DIR=/opt/codex-switch-terminal/current/dist
CST_PUBLIC_BASE_URL=https://oracle-free-cst.YOUR_TAILNET.ts.net
CST_ALLOWED_ORIGINS=https://oracle-free-cst.YOUR_TAILNET.ts.net
CST_ADMIN_TOKEN=change-this-long-random-token
CST_GIT_PAT=
CST_NODE_ID=oracle-free
CST_NODE_LABEL=Oracle Free
CST_NODE_CAPACITY=1
# 0 = admission sans plafond logiciel. Une valeur positive reactive un cap dur.
CST_MAX_AGENTS=0
# Preparations/rebases/verifications de merge concurrentes (1 a 32).
CST_MERGE_WORKERS=4
# Optionnel, execute uniquement pour submit_for_merge({ verify: true }).
CST_MERGE_VERIFY_COMMAND=
# Bornes anti-blocage pour la verification et les operations Git distantes.
CST_MERGE_VERIFY_TIMEOUT_SECS=900
CST_MERGE_NETWORK_TIMEOUT_SECS=120
