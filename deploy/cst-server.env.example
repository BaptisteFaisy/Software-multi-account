CST_BIND=127.0.0.1:8080
CST_DATA_DIR=/srv/cst
# Optionnel : partage uniquement settings.json entre plusieurs instances.
# CST_ACCOUNTS_DIR=/srv/cst-shared-accounts
CST_STATIC_DIR=/opt/codex-switch-terminal/current/dist
CST_PUBLIC_BASE_URL=https://oracle-free-cst.YOUR_TAILNET.ts.net
CST_ALLOWED_ORIGINS=https://oracle-free-cst.YOUR_TAILNET.ts.net
CST_ADMIN_TOKEN=change-this-long-random-token
# Le premier compte peut toujours etre cree. Passe ensuite cette valeur a false
# pour fermer les inscriptions locales et la creation de nouveaux comptes Google.
CST_ALLOW_REGISTRATION=true
# Automatique avec une CST_PUBLIC_BASE_URL en https. A forcer seulement si le
# TLS est termine par un proxy dont l'URL publique n'est pas en https ci-dessus.
# CST_AUTH_SECURE_COOKIE=true
# OAuth Google (optionnel). Cree un client OAuth 2.0 de type "Application Web"
# et autorise exactement l'URI de redirection publique ci-dessous.
# CST_GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
# CST_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# CST_GOOGLE_REDIRECT_URI=https://oracle-free-cst.YOUR_TAILNET.ts.net/api/auth/google/callback
# Microsoft 365 (optionnel) : Outlook et agenda dans le chat. Enregistre une
# application Entra ID, ajoute l'URI de redirection de type "Web" strictement
# identique a la ligne ci-dessous, puis accorde les permissions Graph deleguees.
# Les deux premieres valeurs vont ensemble ; les deux suivantes sont facultatives
# (tenant par defaut "common", redirection deduite de CST_PUBLIC_BASE_URL).
# Hors boucle locale la redirection doit etre en https, sinon l'integration se
# desactive au demarrage. Procedure detaillee : docs/microsoft-365.md.
# CST_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# CST_MICROSOFT_CLIENT_SECRET=replace-with-entra-client-secret
# CST_MICROSOFT_TENANT_ID=common
# CST_MICROSOFT_REDIRECT_URI=https://oracle-free-cst.YOUR_TAILNET.ts.net/api/microsoft/callback
# Facultatif aussi : ne changer que pour retirer une capacite au compte lie.
# CST_MICROSOFT_SCOPES=offline_access openid profile email User.Read Mail.Send Mail.Read Calendars.ReadWrite
# Notifications mobiles FCM (optionnel, alternative administree a la configuration dans l'app).
# Le fichier de compte de service reste hors du depot et hors de l'APK.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/cst-firebase-service-account.json
# CST_FIREBASE_PROJECT_ID=mon-projet-firebase
CST_GIT_PAT=
# Compte de secours du Studio IA image/video (optionnel). Garde cette cle uniquement sur le serveur.
# CST_FAL_KEY=key-id:key-secret
CST_NODE_ID=oracle-free
CST_NODE_LABEL=Oracle Free
CST_NODE_CAPACITY=1
# Voix sur navigateur/mobile (optionnel) : le serveur relaie le WAV vers des
# services GPU HTTPS. Ne publie jamais directement Ollama sur Internet.
# CST_VOICE_TRANSCRIPTION_MODE=remote
# CST_VOICE_TRANSCRIPTION_URL=https://gpu.example.net/stt/v1/audio/transcriptions
# CST_VOICE_TRANSCRIPTION_MODEL=Systran/faster-whisper-small
# CST_VOICE_TRANSCRIPTION_ACCELERATOR=gpu
# CST_VOICE_TRANSCRIPTION_API_KEY=replace-with-stt-token
# CST_VOICE_OLLAMA_URL=https://gpu.example.net/ollama
# CST_VOICE_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# CST_VOICE_OLLAMA_API_KEY=replace-with-ollama-token
